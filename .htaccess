# ── CAABSA STEEL — configuración de Apache (cPanel) ───────────────────────────

# 1) Forzar HTTPS y quitar el www
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

# 2) Página de error propia
ErrorDocument 404 /404.html

# 3) Compresión (el HTML del sitio comprime muy bien)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# 4) Caché del navegador. Las imágenes y el video no cambian; el HTML sí.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html                 "access plus 0 seconds"
  ExpiresByType text/css                  "access plus 1 year"
  ExpiresByType application/javascript    "access plus 1 year"
  ExpiresByType image/jpeg                "access plus 1 year"
  ExpiresByType image/png                 "access plus 1 year"
  ExpiresByType image/svg+xml             "access plus 1 year"
  ExpiresByType video/mp4                 "access plus 1 year"
  ExpiresByType application/pdf           "access plus 1 month"
</IfModule>

# 5) El video debe poder reproducirse por partes (barra de avance)
<IfModule mod_headers.c>
  <FilesMatch "\.(mp4)$">
    Header set Accept-Ranges bytes
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# 6) No listar el contenido de las carpetas
Options -Indexes
